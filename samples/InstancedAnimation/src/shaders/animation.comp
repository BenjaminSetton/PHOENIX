#version 460

layout(local_size_x = 64) in;

struct BoneInfo
{
    int parentIndex;
    uint nodeIndex;
    vec2 _pad;
    mat4 offsetMatrix;
    mat4 bindLocalTransform;
};

struct Keyframe
{
    float time;
    float _pad0[3];
    vec4 translation;  // xyz used, w unused
    vec4 rotation;     // quaternion (x, y, z, w)
    vec4 scale;        // xyz used, w unused
};

struct ChannelInfo
{
    uint nodeIndex;
    uint keyframeOffset;
    uint keyframeCount;
    uint _pad;
};

struct ClipInfo
{
    float duration;
    float ticksPerSecond;
    uint channelOffset;
    uint channelCount;
};

struct InstanceData
{
    mat4 modelMatrix;
    float timeOffset;
    uint clipIndex;
    uint _pad[2];
};

layout(set = 0, binding = 0) readonly buffer SkeletonBuffer
{
    BoneInfo bones[];
};

layout(set = 0, binding = 1) readonly buffer KeyframeBuffer
{
    Keyframe keyframes[];
};

layout(set = 0, binding = 2) readonly buffer ClipInfoBuffer
{
    ClipInfo clips[];
};

layout(set = 0, binding = 3) readonly buffer ChannelInfoBuffer
{
    ChannelInfo channels[];
};

layout(set = 0, binding = 4) readonly buffer InstanceBuffer
{
    InstanceData instances[];
};

layout(set = 0, binding = 5) buffer BoneMatrixBuffer
{
    mat4 boneMatrices[];
};

layout(set = 0, binding = 6) uniform AnimParams
{
    float globalTime;
    uint boneCount;
    uint instanceCount;
    float _pad;
};

layout(set = 0, binding = 7) readonly buffer NodeParentBuffer
{
    int nodeParents[];
};

layout(set = 0, binding = 8) readonly buffer NodeTransformBuffer
{
    mat4 nodeLocalTransforms[];
};

// Build a transformation matrix from translation, rotation (quaternion), and scale
mat4 buildMatrix(vec4 translation, vec4 rotation, vec4 scale)
{
    // Quaternion to rotation matrix
    float qx = rotation.x;
    float qy = rotation.y;
    float qz = rotation.z;
    float qw = rotation.w;

    float n = qx * qx + qy * qy + qz * qz + qw * qw;
    if (n > 0.0) {
        float s = 2.0 / n;
        float xs = qx * s, ys = qy * s, zs = qz * s;
        float wx = qw * xs, wy = qw * ys, wz = qw * zs;
        float xx = qx * xs, xy = qx * ys, xz = qx * zs;
        float yy = qy * ys, yz = qy * zs, zz = qz * zs;

        // Quaternion-to-rotation-matrix, matching GLM's mat3_cast(quat) exactly
        // (glm/gtc/quaternion.inl). This is a plain quaternion->matrix conversion,
        // not an Assimp matrix, so no transpose is needed here.
        mat3 rot = mat3(
            1.0 - (yy + zz), xy + wz,          xz - wy,
            xy - wz,          1.0 - (xx + zz), yz + wx,
            xz + wy,          yz - wx,          1.0 - (xx + yy)
        );

        // TRS matrix (column-major): columns are scaled rotation axes + translation
        return mat4(
            scale.x * rot[0][0], scale.x * rot[0][1], scale.x * rot[0][2], 0.0,
            scale.y * rot[1][0], scale.y * rot[1][1], scale.y * rot[1][2], 0.0,
            scale.z * rot[2][0], scale.z * rot[2][1], scale.z * rot[2][2], 0.0,
            translation.x,       translation.y,       translation.z,       1.0
        );
    }
    return mat4(1.0);
}

// Spherical linear interpolation between two quaternions
vec4 slerp(vec4 q0, vec4 q1, float t)
{
    float dotProduct = dot(q0, q1);
    if (dotProduct < 0.0) {
        q1 = -q1;
        dotProduct = -dotProduct;
    }
    if (dotProduct > 0.9995) {
        return normalize(mix(q0, q1, t));
    }
    float theta = acos(dotProduct);
    float sinTheta = sin(theta);
    float w0 = sin((1.0 - t) * theta) / sinTheta;
    float w1 = sin(t * theta) / sinTheta;
    return w0 * q0 + w1 * q1;
}

// Find the animation channel for a given node index and compute its interpolated local transform.
// Returns true if a channel was found, false otherwise (caller should use bind-pose transform).
bool computeChannelTransform(uint nodeIndex, ClipInfo clip, float animTime, out mat4 result)
{
    for (uint c = clip.channelOffset; c < clip.channelOffset + clip.channelCount; c++)
    {
        ChannelInfo chInfo = channels[c];
        if (chInfo.nodeIndex != nodeIndex)
            continue;

        if (chInfo.keyframeCount == 0)
        {
            result = mat4(1.0);
            return true;
        }
        if (chInfo.keyframeCount == 1)
        {
            Keyframe kf = keyframes[chInfo.keyframeOffset];
            result = buildMatrix(kf.translation, kf.rotation, kf.scale);
            return true;
        }

        // Find the two keyframes to interpolate between
        uint kf0 = 0;
        uint kf1 = 1;
        for (uint k = 0; k < chInfo.keyframeCount - 1; k++)
        {
            if (keyframes[chInfo.keyframeOffset + k].time <= animTime &&
                keyframes[chInfo.keyframeOffset + k + 1].time >= animTime)
            {
                kf0 = k;
                kf1 = k + 1;
                break;
            }
        }

        // Clamp to edges
        if (animTime >= keyframes[chInfo.keyframeOffset + chInfo.keyframeCount - 1].time)
        {
            kf0 = chInfo.keyframeCount - 1;
            kf1 = kf0;
        }
        if (animTime <= keyframes[chInfo.keyframeOffset].time)
        {
            kf0 = 0;
            kf1 = 0;
        }

        Keyframe k0 = keyframes[chInfo.keyframeOffset + kf0];
        Keyframe k1 = keyframes[chInfo.keyframeOffset + kf1];

        float t = 0.0;
        if (k1.time > k0.time)
        {
            t = clamp((animTime - k0.time) / (k1.time - k0.time), 0.0, 1.0);
        }

        vec4 trans = mix(k0.translation, k1.translation, t);
        vec4 rot = slerp(k0.rotation, k1.rotation, t);
        vec4 scale = mix(k0.scale, k1.scale, t);

        result = buildMatrix(trans, rot, scale);
        return true;
    }
    result = mat4(1.0);
    return false;
}

void main()
{
    if (boneCount == 0) return;

    uint instanceIdx = gl_GlobalInvocationID.x / boneCount;
    uint boneIdx = gl_GlobalInvocationID.x % boneCount;

    if (instanceIdx >= instanceCount) return;

    InstanceData inst = instances[instanceIdx];
    uint clipIdx = inst.clipIndex;

    if (clipIdx >= 16) return; // safety clamp

    ClipInfo clip = clips[clipIdx];
    float animTime = mod(globalTime + inst.timeOffset, clip.duration / max(clip.ticksPerSecond, 0.001)) * max(clip.ticksPerSecond, 0.001);

    // Traverse the NODE hierarchy from this bone's node up to root
    uint nodeIdx = bones[boneIdx].nodeIndex;

    // Build the node chain from root to this bone's node (max 64 levels deep)
    int chain[64];
    int chainLen = 0;
    int currentNode = int(nodeIdx);
    while (currentNode >= 0 && chainLen < 64)
    {
        chain[chainLen] = currentNode;
        currentNode = nodeParents[currentNode];
        chainLen++;
    }

    // Compose global transform from root to leaf
    mat4 globalTransform = mat4(1.0);
    for (int i = chainLen - 1; i >= 0; i--)
    {
        int nIdx = chain[i];

        mat4 localTransform;
        bool found = computeChannelTransform(uint(nIdx), clip, animTime, localTransform);
        if (!found)
        {
            localTransform = nodeLocalTransforms[nIdx];
        }

        globalTransform = globalTransform * localTransform;
    }

    // Final bone matrix = globalTransform * offsetMatrix
    mat4 finalMatrix = globalTransform * bones[boneIdx].offsetMatrix;

    // Output: indexed by instance * boneCount + boneIdx
    boneMatrices[instanceIdx * boneCount + boneIdx] = finalMatrix;
}
