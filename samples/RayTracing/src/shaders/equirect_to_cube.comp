#version 460
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D equirectMap;
layout(set = 0, binding = 1, rgba16f) uniform imageCube cubeMap;

layout(set = 0, binding = 2) uniform CubeFaceSize
{
    uvec2 faceSize;
} u;

// Convert a direction to equirectangular UV coordinates
vec2 directionToEquirectUV(vec3 dir)
{
    float u = atan(dir.z, dir.x) * 0.15915494309189535 + 0.5;
    float v = asin(clamp(dir.y, -1.0, 1.0)) * 0.3183098861837907 + 0.5;
    return vec2(u, v);
}

// Convert (face, x, y) to a direction
vec3 faceCoordToDirection(uint face, vec2 uv)
{
    // uv is in [0, 1] per face, map to [-1, 1]
    vec2 d = uv * 2.0 - 1.0;

    vec3 dir;
    switch (face)
    {
    case 0: dir = vec3( 1.0,   d.y,  -d.x); break; // +X
    case 1: dir = vec3(-1.0,   d.y,   d.x); break; // -X
    case 2: dir = vec3(  d.x, -1.0,   d.y); break; // +Y
    case 3: dir = vec3(  d.x,  1.0,  -d.y); break; // -Y
    case 4: dir = vec3(  d.x,  d.y,   1.0); break; // +Z
    case 5: dir = vec3( -d.x,  d.y,  -1.0); break; // -Z
    default: dir = vec3(0.0); break;
    }
    return normalize(dir);
}

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= u.faceSize.x || pixel.y >= u.faceSize.y)
        return;

    uint face = gl_GlobalInvocationID.z;
    if (face >= 6)
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(u.faceSize);
    vec3 dir = faceCoordToDirection(face, uv);

    vec2 equirectUV = directionToEquirectUV(dir);
    vec3 color = texture(equirectMap, equirectUV).rgb;

    imageStore(cubeMap, ivec3(pixel.x, pixel.y, int(face)), vec4(color, 1.0));
}
