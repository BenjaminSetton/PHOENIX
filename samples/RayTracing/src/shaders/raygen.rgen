#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable

#include "common.glsl"

layout(set = 0, binding = 0, rgba16f) uniform image2D outputImage;
layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 7, rgba16f) uniform image2D accumulationImage;

layout(set = 1, binding = 0) uniform CameraData
{
    mat4 viewInverse;
    mat4 projInverse;
    vec3 cameraPosition;
    float padding0;
    vec2 viewport;
    uint frameCount;
    uint resetAccumulation;
    vec2 padding1;
} camera;

layout(location = 0) rayPayloadEXT vec3 hitColor;

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);

    // Per-pixel random seed based on pixel coords and frame count
    uint seed = uint(pixel.x) + uint(pixel.y) * uint(gl_LaunchSizeEXT.x) + camera.frameCount * 719393u;
    vec2 jitter = randVec2(seed) - 0.5;

    vec2 uv = (vec2(pixel) + 0.5 + jitter) / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 target = camera.projInverse * vec4(ndc, 0.0, 1.0);
    vec3 direction = normalize(mat3(camera.viewInverse) * target.xyz);
    vec3 origin = camera.viewInverse[3].xyz;

    float tMin = 0.001;
    float tMax = 1000.0;

    traceRayEXT(topLevelAS, 0, 0xff, 0, 0, 0, origin, tMin, direction, tMax, 0);

    // Clamp to prevent fireflies from high-variance specular samples
    hitColor = min(hitColor, vec3(10.0));

    // Progressive accumulation
    if (camera.resetAccumulation == 1u)
    {
        imageStore(accumulationImage, pixel, vec4(hitColor, 1.0));
    }
    else
    {
        vec3 prevAccum = imageLoad(accumulationImage, pixel).rgb;
        vec3 newAccum = (prevAccum * float(camera.frameCount) + hitColor) / float(camera.frameCount + 1u);
        imageStore(accumulationImage, pixel, vec4(newAccum, 1.0));
    }

    // Write the accumulated result to the output image for the blit pass
    vec3 finalColor = imageLoad(accumulationImage, pixel).rgb;
    imageStore(outputImage, pixel, vec4(finalColor, 1.0));
}
